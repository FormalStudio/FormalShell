// FormalShell's shipped default menu tree (dotted-id hierarchy, per-key
// user-overridable at ~/.config/formalshell/menu.jsonc, see model.js's
// buildTree()). Kind is inferred per entry: `action` -> action, `target` ->
// link, `provider` -> submenu populated at tree-build time by providers.js
// (see "apps" below), else a plain submenu.
//
// Internal actions: an `action` value prefixed `@ipc:` is dispatched
// in-process instead of spawned via `sh -c`, and the launcher's activation
// switches on the name after the prefix (e.g. "@ipc:theme.toggleMode"). Use
// this for anything that must run in the shell's own process rather than as
// a detached command.
//
// Grouping: `section` is the heading the launcher draws above a run of rows
// that share it (model.js's sectionsFor), and rows are never reordered to
// fit one, so the declaration order here is what makes a section one block.
// A node with no `section` falls back to the level it sits in, which is
// "Commands" at the root. `prompt` overrides what the search field says
// while standing inside that node ("Search <label>" otherwise).
//
// Modes: `prefix` is what, typed with a space after it from any level, enters
// that route as a mode (`":e cry"` is Emoji searching "cry").
//
// Live state: a `checked` value prefixed `@state:` resolves in-process from
// the launcher's state snapshot against toggles.js's closed allow-list, never
// through `sh -c` and never cached, so the checkmark repaints the instant the
// underlying state flips. `@state:` is a `checked` prefix only; a `when`
// carrying it is refused with a warning and the node hides. `"keepOpen":
// true` on an action row leaves the menu open after activation.
//
// Actions: a node's `actions` array is what Tab lists past its kind's own
// (fs-menu actions.rs `actions_for`), each `{id, label, icon?, action,
// confirm?, keepOpen?}`. An id a built-in already uses overrides it, and
// `"hidden": true` on one removes it.
{
    // The six routes anyone opens the launcher for lead the root under one
    // heading; everything after them falls back to "Commands".
    "apps": { "provider": "apps", "section": "Suggestions", "prompt": "Search apps" },
    "clipboard": { "provider": "clipboard", "section": "Suggestions", "prompt": "Search clipboard history" },
    // "calc" registers no provider fn, the node exists as a summonable
    // route (`menu summon calc`) whose level the launcher special-cases to show
    // only the live CALC result row for the typed expression (calc.js).
    "calc": { "label": "Calculator", "provider": "calc", "section": "Suggestions", "prompt": "Type an expression" },
    // "emoji" registers no provider fn either: a summonable route
    // (`menu summon emoji`) whose level the launcher renders as a GRID over the
    // vendored emoji dataset (emoji.json) instead of the tree.
    "emoji": { "label": "Emoji", "provider": "emoji", "section": "Suggestions", "prompt": "Search emoji", "prefix": ":e" },
    // "wallpaper" registers no provider fn either: a summonable route
    // (`menu summon wallpaper`, and the whole `picker` IPC target) whose
    // level the launcher renders as an image GRID over `picker.directory`
    // rather than as rows, the wallpaper picker lives inside the menu now
    // instead of being a popout of its own. The search field filters it by
    // filename like any other level.
    "wallpaper": { "label": "Wallpaper", "provider": "wallpaper", "aliases": ["picker", "background"], "section": "Suggestions", "prompt": "Search wallpapers" },
    // "monitor" registers no provider fn either, on the same footing as
    // "wallpaper" above: a summonable route (`menu summon monitor`) whose
    // level the launcher renders as a whole APP VIEW rather than as rows,
    // registered against this id. The full system monitor lives here for anyone who
    // does not want its bar cell, which is opt-in. The declared "provider"
    // is what keeps the row itself listed: a childless "submenu" is
    // filtered out of its parent level (model.js's visibleChildren), a
    // childless "provider" is not.
    // The process table lives inside that view (btop's layout), so the
    // aliases for it are this route's too: `ps`, `top` and `htop` are what
    // someone reaching for a process list actually types.
    "monitor": { "label": "System Monitor", "provider": "monitor", "aliases": ["sysmon", "system", "cpu", "gpu", "ps", "top", "htop", "processes", "kill", "task", "tasks", "activity"], "section": "Suggestions", "prompt": "Filter processes" },

    // "mirror" registers no provider fn either, on the same footing as
    // "monitor" above: an app view (registered against this id) showing the live camera feed, Tab
    // stepping through the cameras. The word "mirror" is this route's; the
    // display panel's own mirroring is reached by "display", "mirror display"
    // or "screen mirroring" (Menu/providers.js PANEL_NAMES).
    "mirror": { "label": "Mirror", "provider": "mirror", "aliases": ["camera", "webcam", "selfie", "ir camera"], "section": "Suggestions", "prompt": "Tab switches camera" },

    // "keybinds" registers no provider fn either: a summonable route
    // (`menu summon keybinds`) whose level the launcher fills from the parsed
    // compositor binds (Compositor/keybinds.js). Rows are inert notes, never
    // activatable.
    "keybinds": { "label": "Keybinds", "provider": "keybinds", "aliases": ["keys", "hotkeys", "shortcuts"], "prompt": "Search keybinds", "prefix": ":k" },
    // "files" is filled on the shell's service thread from GTK's
    // recently-used.xbel and the XDG user directories (providers/files.rs):
    // no index, so its rows rank in a root search as file and folder
    // subjects, and → on a folder lists that folder.
    "files": { "label": "Files", "provider": "files", "aliases": ["recent", "documents", "folders"], "prompt": "Search files", "prefix": ":f" },
    // "wifi" registers a provider fn (providers.js's wifiRows): the scanned
    // networks with saved ones first, Enter connecting (a password step for a
    // secured new one) and Shift+Enter forgetting. Separate from the "Network"
    // panel row under Panels, which opens the card. Nearby unknown networks
    // are searchable only from inside the level.
    "wifi": { "label": "Wi-Fi", "provider": "wifi", "aliases": ["wifi", "wlan", "network", "ssid", "internet"], "prompt": "Search networks" },
    // "bluetooth" registers a provider fn (providers.js's bluetoothRows): the
    // paired devices, connected ones ticked, Enter connecting or
    // disconnecting. No pairing here, that stays the "Bluetooth" panel's job.
    "bluetooth": { "label": "Bluetooth Devices", "provider": "bluetooth", "aliases": ["bt", "headphones", "earbuds", "speaker"], "prompt": "Search devices" },

    // "audio" registers a provider fn (providers.js's audioRows): outputs then
    // inputs, the default ticked, Enter making a device the default. Volume
    // stays in the "Audio" panel.
    "audio": { "label": "Audio Devices", "provider": "audio", "aliases": ["sound", "output", "input", "speakers", "microphone", "mic", "sink", "source"], "prompt": "Search devices" },

    // "radio" registers a provider fn (providers.js's radioRows): Stop while a
    // station plays, then the favourites with the tuned one ticked, Enter
    // playing. "radio.search" registers none, so it stays a listed route
    // (`menu summon radio.search`) that the launcher fills from Radio Browser,
    // its results searchable only from inside that level. The "Radio" row
    // under Panels opens the card.
    "radio": { "label": "Radio Stations", "provider": "radio", "aliases": ["stations", "fm", "stream"], "prompt": "Search favorites" },
    "radio.search": { "label": "Search", "provider": "radioSearch", "prompt": "Search Radio Browser", "prefix": ":r" },

    // "panels" registers a provider fn too: one row per name in
    // the panel registry, each spawning "panel open <name>"
    // over IPC (providers.js's panelsProvider) -- the launcher route for
    // every popout that otherwise only opens from its own bar cell. A root
    // query walks them, so typing "iphone" or "radio" opens that panel.
    "panels": { "label": "Panels", "provider": "panels" },
    // "tray" is the live SNI tray (providers.js's trayProvider): one row per
    // registered item, activating it the same way a left click on its bar
    // cell does. "routeOnly" keeps those rows out of a root query
    // (search.js's rank): an item's label is its tooltip title, which for
    // most items is exactly the application name, so a root search that
    // walked them returned "Equibop" twice. The route row itself still
    // matches from anywhere, so "tray" still reaches the tray.
    "tray": { "label": "Tray", "provider": "tray", "routeOnly": true },
    // "gpu" registers a provider fn too (providers.js's gpuProvider): one
    // inert note row per GpuService card -- name, integrated/discrete,
    // driver, connected outputs -- informational only, same non-activatable
    // footing as "keybinds" above. "gpu.mode" (supergfxctl integrated/hybrid
    // switching) is NOT declared here: the launcher merges it in at tree-build
    // time (providers.js's gpuModeEntry), because it must be genuinely
    // absent -- not present and empty -- on a machine with no supergfxctl.
    // Launching an app on the discrete card is Shift+Enter on the app row,
    // not a route under here listing every app a second time.
    "gpu": { "label": "GPU", "provider": "gpu" },

    "system": { "label": "System" },
    // Asked of logind, so the lock comes back on the session's Lock signal
    // like every other locker's.
    "system.lock": { "action": "@ipc:lock.session" },
    // logind over D-Bus in process, never a spawned `systemctl`: logind's
    // answer has to reach the shell, a refusal as a toast.
    "system.suspend": { "action": "@ipc:power.suspend" },
    "system.reboot": { "action": "@ipc:power.reboot", "confirm": true },
    "system.shutdown": { "action": "@ipc:power.poweroff", "confirm": true },
    "system.logout": { "action": "@ipc:power.logout" },
    "system.notifications": {
        "label": "Notifications",
        "action": "@ipc:notifications.showHistory"
    },

    // REMINDERS: a countdown plus a message, fired through
    // NotificationService at urgency 2 so it bypasses DND. "Set Reminder"
    // opens the menu's own input field (`@ipc:reminder.set` ->
    // Menu.openInput with ReminderService's token) rather than taking an
    // argument here. No `when` on any node: `when` runs a shell command and
    // cannot gate on in-process state, so Clear Reminders stays visible and
    // is a harmless no-op on an empty list.
    "reminder": { "label": "Reminder" },
    "reminder.set": { "label": "Set Reminder", "action": "@ipc:reminder.set" },
    "reminder.show": { "label": "Show Reminders", "action": "@ipc:reminder.show" },
    "reminder.clear": { "label": "Clear Reminders", "action": "@ipc:reminder.clear" },

    // SHARE (M17 Task 1, restructured M75 Task 5 for localsend-cli):
    // present when either localsend-cli (the primary path, peers under
    // Send, LocalsendService) or the GUI's `localsend_app` (the fallback,
    // nixpkgs' pkgs.localsend, verified against its actual installed bin/,
    // not the bare `localsend` name omarchy assumes) resolves on PATH --
    // the standard `command -v` presence guard (the Tailscale panel's
    // own "NO TAILSCALE" check uses the same idiom). Every child is
    // dynamic, none declared here: providers.js's sharePeerEntries()
    // builds the whole subtree at tree-build time, picking the CLI or the
    // GUI shape off whether LocalSend is installed, the same
    // fully-dynamic pattern gpuModeEntry uses for "gpu.mode.*".
    "share": {
        "label": "Share",
        "when": "command -v localsend-cli >/dev/null 2>&1 || command -v localsend_app >/dev/null 2>&1"
    },

    // CLIPSSH: present only when `clipssh` resolves on PATH (the same
    // presence-gate idiom as "share" above), each row is a saved alias
    // from ~/.clipssh/aliases (providers.js's clipsshRows), Enter sends
    // the current clipboard image to that host and copies the remote path
    // back.
    "clipssh": { "label": "Clipssh", "provider": "clipssh", "when": "command -v clipssh >/dev/null 2>&1" },

    // TOGGLE HUB: every row is a live in-process toggle. `checked` takes an
    // "@state:" condition (toggles.js's allow-list, resolved from the
    // launcher's state snapshot, never a Process, so the checkmark flips in the same
    // turn the toggle does), and `keepOpen` holds the surface open so that
    // flip is actually visible.
    "toggles": { "label": "Toggles" },
    "toggles.nightlight": {
        "label": "Night Light",
        "action": "@ipc:nightlight.toggle",
        "checked": "@state:nightlight.active",
        "keepOpen": true,
        "actions": [{ "id": "panel", "label": "Open display panel", "action": "@ipc:panel.open:display" }],
        "when": "command -v wlsunset >/dev/null 2>&1"
    },
    "toggles.overnight": {
        "label": "Overnight",
        "action": "@ipc:overnight.toggle",
        "checked": "@state:overnight.active",
        "keepOpen": true
    },
    "toggles.caffeinate": {
        "label": "Caffeinate",
        "action": "@ipc:caffeinate.toggle",
        "checked": "@state:caffeinate.active",
        "keepOpen": true
    },
    "toggles.hdr": {
        "label": "HDR",
        "action": "@ipc:hdr.toggle",
        "checked": "@state:hdr.active",
        "keepOpen": true,
        "actions": [{ "id": "panel", "label": "Open display panel", "action": "@ipc:panel.open:display" }]
    },
    "toggles.dnd": {
        "label": "Do Not Disturb",
        "action": "@ipc:notifications.toggleDnd",
        "checked": "@state:notifications.dnd",
        "keepOpen": true
    },
    "toggles.dark-mode": {
        "label": "Dark Mode",
        "action": "@ipc:theme.toggleMode",
        "checked": "@state:theme.dark",
        "keepOpen": true
    }

    // The root "capture" node (OCR, colour pick, record, stop, video-to-GIF,
    // plain screenshot/region) is injected at tree-build time by the launcher via
    // providers.js's captureEntries(): its actions target the running
    // shell's own path, which static jsonc can't know. The same function
    // also injects "system.console", "system.screensaver",
    // "system.plugins"/".list"/".reload", the root "notifications" node
    // (".clear"/".markAllSeen"/".dismissAll", separate from the existing
    // "system.notifications" leaf), and the root "theme" node
    // (".retheme"/".mode-dark"/".mode-light") -- every one of them a
    // self-targeted IPC leaf for the same reason. Override or hide any
    // of them from menu.jsonc by their declared id like any other node.
}
