#!/usr/bin/env bash
# Regenerates docs/shots/: one --shots session (dev/smoke.d/shots.sh). On a
# mac it runs on g815's rig, which pulls the files back; on Linux it nests a
# session here.
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "$(uname)" = Darwin ]; then
  run=(./dev/remote.sh smoke)
else
  run=(./dev/smoke.sh)
fi
"${run[@]}" --showcase --shots
ls -l docs/shots
